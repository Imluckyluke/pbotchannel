# my.telegram.org
API_ID=123456
API_HASH=your_api_hash

# ربات معمولی (BotFather)
BOT_TOKEN=123456:xxxxxxxxxxxxxxxxxxxxxxxx

# اختیاری: اگه از generate_session.py استفاده کردی اینجا بذار.
# اگه خالی بذاری، از پنل داخل ربات («ورود با شماره» یا «Session String») لاگین میکنی.
SESSION_STRING=

# آیدی عددی ادمین(های) اولیه، با کاما جدا کن (بعدا از پنل هم میشه اضافه کرد)
ADMIN_IDS=123456789

# اختیاری: مسیر فایل دیتابیس. روی ریلوی حتما به یه Volume اشاره کن
# (مثلا /data/data.sqlite3) وگرنه سر هر ری‌دیپلوی سشن و تنظیمات پاک میشن.
DB_PATH=data.sqlite3
